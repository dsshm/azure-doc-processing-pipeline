# Copy to .env and fill in values for local development.
# No API keys — uses DefaultAzureCredential (az login / managed identity).

# Optional — only needed if DefaultAzureCredential can't auto-detect your tenant
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-docintel>.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_MODEL_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
AZURE_STORAGE_ACCOUNT_URL=https://<your-storage>.blob.core.windows.net
COSMOS_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
COSMOS_DATABASE_NAME=docprocessing
LOG_LEVEL=INFO
MAX_CONCURRENT_JOBS=5
