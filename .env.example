# Copy to .env and fill in values for local development.
# No API keys — uses DefaultAzureCredential (az login / managed identity).

# Optional — only needed if DefaultAzureCredential can't auto-detect your tenant
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-docintel>.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_MODEL_NAME=gpt-5.1
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-12-01-preview
AZURE_MAPS_ENDPOINT=https://atlas.microsoft.com
AZURE_MAPS_CLIENT_ID=<your-azure-maps-account-client-id>
AZURE_MAPS_COUNTRY_SET=US
AZURE_MAPS_LANGUAGE=en-US
AZURE_MAPS_FUZZY_SEARCH_LIMIT=1
AZURE_MAPS_MAX_FUZZY_LEVEL=1
AZURE_MAPS_TIMEOUT_SECONDS=10
AZURE_STORAGE_ACCOUNT_URL=https://<your-storage>.blob.core.windows.net
COSMOS_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
COSMOS_DATABASE_NAME=docprocessing
SEARCH_DEFAULT_TOP=30
SEARCH_MAX_TOP=1000
BACKFILL_DEFAULT_LIMIT=25
BACKFILL_MAX_LIMIT=200
LOG_LEVEL=INFO
MAX_CONCURRENT_JOBS=5
