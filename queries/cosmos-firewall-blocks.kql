union isfuzzy=true CDBDataPlaneRequests, AzureDiagnostics
| extend
    SourceTable = tostring(Type),
    ResourceProviderText = tostring(column_ifexists("ResourceProvider", "")),
    CategoryText = tostring(column_ifexists("Category", "")),
    Account = iff(isnotempty(tostring(column_ifexists("AccountName", ""))), tostring(column_ifexists("AccountName", "")), tostring(column_ifexists("Resource", ""))),
    Database = iff(isnotempty(tostring(column_ifexists("DatabaseName", ""))), tostring(column_ifexists("DatabaseName", "")), tostring(column_ifexists("databaseName_s", ""))),
    Container = iff(isnotempty(tostring(column_ifexists("CollectionName", ""))), tostring(column_ifexists("CollectionName", "")), tostring(column_ifexists("collectionName_s", ""))),
    Operation = iff(isnotempty(tostring(column_ifexists("OperationName", ""))), tostring(column_ifexists("OperationName", "")), tostring(column_ifexists("operationName_s", ""))),
    Status = iff(isnotempty(tostring(column_ifexists("StatusCode", ""))), tostring(column_ifexists("StatusCode", "")), iff(isnotempty(tostring(column_ifexists("statusCode_s", ""))), tostring(column_ifexists("statusCode_s", "")), tostring(column_ifexists("statusCode_d", "")))),
    SubStatus = iff(isnotempty(tostring(column_ifexists("SubStatusCode", ""))), tostring(column_ifexists("SubStatusCode", "")), iff(isnotempty(tostring(column_ifexists("subStatusCode_s", ""))), tostring(column_ifexists("subStatusCode_s", "")), tostring(column_ifexists("subStatusCode_d", "")))),
    ClientIp = iff(isnotempty(tostring(column_ifexists("ClientIpAddress", ""))), tostring(column_ifexists("ClientIpAddress", "")), iff(isnotempty(tostring(column_ifexists("clientIpAddress_s", ""))), tostring(column_ifexists("clientIpAddress_s", "")), tostring(column_ifexists("ClientIP_s", "")))),
    ActivityIdText = iff(isnotempty(tostring(column_ifexists("ActivityId", ""))), tostring(column_ifexists("ActivityId", "")), iff(isnotempty(tostring(column_ifexists("activityId_g", ""))), tostring(column_ifexists("activityId_g", "")), tostring(column_ifexists("ActivityId_g", "")))),
    UserAgentText = iff(isnotempty(tostring(column_ifexists("UserAgent", ""))), tostring(column_ifexists("UserAgent", "")), iff(isnotempty(tostring(column_ifexists("userAgent_s", ""))), tostring(column_ifexists("userAgent_s", "")), tostring(column_ifexists("UserAgent_s", "")))),
    ResourceIdText = tostring(column_ifexists("_ResourceId", column_ifexists("ResourceId", "")))
| where SourceTable == "CDBDataPlaneRequests" or (SourceTable == "AzureDiagnostics" and ResourceProviderText =~ "MICROSOFT.DOCUMENTDB" and CategoryText == "DataPlaneRequests")
| where Status == "403" or SubStatus in ("5300", "5301", "5302", "5303")
| summarize
    BlockedRequests = count(),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    Operations = make_set(Operation, 10),
    Containers = make_set(Container, 10),
    ActivityIds = make_set(ActivityIdText, 10),
    UserAgents = make_set(UserAgentText, 10)
    by ClientIp, Account, Status, SubStatus, SourceTable
| order by LastSeen desc
