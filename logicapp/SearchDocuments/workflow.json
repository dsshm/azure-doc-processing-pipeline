{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "manual": {
        "type": "Request",
        "kind": "Http",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "top": {
                "type": "integer",
                "minimum": 1
              },
              "mode": {
                "type": "string",
                "enum": [
                  "hybrid",
                  "full-text",
                  "vector"
                ]
              },
              "vector_field": {
                "type": "string",
                "enum": [
                  "summary_vector",
                  "purpose_vector"
                ]
              }
            },
            "required": [
              "query"
            ]
          }
        }
      }
    },
    "actions": {
      "Normalize_query": {
        "type": "Compose",
        "inputs": "@trim(string(triggerBody()?['query']))",
        "runAfter": {}
      },
      "Resolve_top": {
        "type": "Compose",
        "inputs": "@if(equals(triggerBody()?['top'], null), int(appsetting('SEARCH_DEFAULT_TOP')), int(triggerBody()?['top']))",
        "runAfter": {
          "Normalize_query": [
            "Succeeded"
          ]
        }
      },
      "Resolve_mode": {
        "type": "Compose",
        "inputs": "@if(empty(triggerBody()?['mode']), 'hybrid', toLower(string(triggerBody()?['mode'])))",
        "runAfter": {
          "Resolve_top": [
            "Succeeded"
          ]
        }
      },
      "Resolve_vector_field": {
        "type": "Compose",
        "inputs": "@if(empty(triggerBody()?['vector_field']), appsetting('SEARCH_DEFAULT_VECTOR_FIELD'), string(triggerBody()?['vector_field']))",
        "runAfter": {
          "Resolve_mode": [
            "Succeeded"
          ]
        }
      },
      "Reject_empty_query": {
        "type": "If",
        "expression": "@empty(outputs('Normalize_query'))",
        "actions": {
          "Return_empty_query": {
            "type": "Response",
            "kind": "Http",
            "inputs": {
              "statusCode": 400,
              "body": {
                "error": "query must not be empty"
              }
            }
          }
        },
        "else": {
          "actions": {
            "Reject_top_over_cap": {
              "type": "If",
              "expression": "@greater(outputs('Resolve_top'), int(appsetting('SEARCH_MAX_TOP')))",
              "actions": {
                "Return_top_over_cap": {
                  "type": "Response",
                  "kind": "Http",
                  "inputs": {
                    "statusCode": 400,
                    "body": {
                      "error": "top exceeds configured SEARCH_MAX_TOP",
                      "maxTop": "@int(appsetting('SEARCH_MAX_TOP'))"
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Route_search_mode": {
                    "type": "Switch",
                    "expression": "@outputs('Resolve_mode')",
                    "cases": {
                      "Full_text": {
                        "case": "full-text",
                        "actions": {
                          "Call_full_text_search": {
                            "type": "Http",
                            "inputs": {
                              "method": "POST",
                              "uri": "@{appsetting('CONTAINER_APP_BASE_URL')}/api/search/full-text",
                              "headers": {
                                "Content-Type": "application/json"
                              },
                              "body": {
                                "query": "@{outputs('Normalize_query')}",
                                "top": "@outputs('Resolve_top')"
                              }
                            }
                          },
                          "Return_full_text_search": {
                            "type": "Response",
                            "kind": "Http",
                            "inputs": {
                              "statusCode": "@outputs('Call_full_text_search')?['statusCode']",
                              "headers": {
                                "Content-Type": "application/json",
                                "x-docpipeline-search-mode": "full-text"
                              },
                              "body": "@body('Call_full_text_search')"
                            },
                            "runAfter": {
                              "Call_full_text_search": [
                                "Succeeded",
                                "Failed",
                                "TimedOut"
                              ]
                            }
                          }
                        }
                      },
                      "Vector": {
                        "case": "vector",
                        "actions": {
                          "Create_vector_query_embedding": {
                            "type": "Http",
                            "inputs": {
                              "method": "POST",
                              "uri": "@{appsetting('AZURE_OPENAI_ENDPOINT')}/openai/deployments/@{appsetting('AZURE_OPENAI_EMBEDDING_MODEL')}/embeddings?api-version=@{appsetting('AZURE_OPENAI_EMBEDDING_API_VERSION')}",
                              "headers": {
                                "Content-Type": "application/json"
                              },
                              "authentication": {
                                "type": "ManagedServiceIdentity",
                                "audience": "https://cognitiveservices.azure.com"
                              },
                              "body": {
                                "input": "@{outputs('Normalize_query')}"
                              }
                            }
                          },
                          "Use_vector_embedding_or_fallback": {
                            "type": "If",
                            "expression": "@and(equals(outputs('Create_vector_query_embedding')?['statusCode'], 200), not(empty(body('Create_vector_query_embedding')?['data']?[0]?['embedding'])))",
                            "actions": {
                              "Call_vector_search_with_embedding": {
                                "type": "Http",
                                "inputs": {
                                  "method": "POST",
                                  "uri": "@{appsetting('CONTAINER_APP_BASE_URL')}/api/search/vector",
                                  "headers": {
                                    "Content-Type": "application/json"
                                  },
                                  "body": {
                                    "query": "@{outputs('Normalize_query')}",
                                    "top": "@outputs('Resolve_top')",
                                    "vector_field": "@{outputs('Resolve_vector_field')}",
                                    "query_vector": "@body('Create_vector_query_embedding')?['data']?[0]?['embedding']"
                                  }
                                }
                              },
                              "Return_vector_search": {
                                "type": "Response",
                                "kind": "Http",
                                "inputs": {
                                  "statusCode": "@outputs('Call_vector_search_with_embedding')?['statusCode']",
                                  "headers": {
                                    "Content-Type": "application/json",
                                    "x-docpipeline-search-mode": "vector"
                                  },
                                  "body": "@body('Call_vector_search_with_embedding')"
                                },
                                "runAfter": {
                                  "Call_vector_search_with_embedding": [
                                    "Succeeded",
                                    "Failed",
                                    "TimedOut"
                                  ]
                                }
                              }
                            },
                            "else": {
                              "actions": {
                                "Call_vector_fallback_full_text": {
                                  "type": "Http",
                                  "inputs": {
                                    "method": "POST",
                                    "uri": "@{appsetting('CONTAINER_APP_BASE_URL')}/api/search/full-text",
                                    "headers": {
                                      "Content-Type": "application/json"
                                    },
                                    "body": {
                                      "query": "@{outputs('Normalize_query')}",
                                      "top": "@outputs('Resolve_top')"
                                    }
                                  }
                                },
                                "Return_vector_fallback_full_text": {
                                  "type": "Response",
                                  "kind": "Http",
                                  "inputs": {
                                    "statusCode": "@outputs('Call_vector_fallback_full_text')?['statusCode']",
                                    "headers": {
                                      "Content-Type": "application/json",
                                      "x-docpipeline-search-mode": "full-text-fallback",
                                      "x-docpipeline-fallback-reason": "embedding-unavailable"
                                    },
                                    "body": "@body('Call_vector_fallback_full_text')"
                                  },
                                  "runAfter": {
                                    "Call_vector_fallback_full_text": [
                                      "Succeeded",
                                      "Failed",
                                      "TimedOut"
                                    ]
                                  }
                                }
                              }
                            },
                            "runAfter": {
                              "Create_vector_query_embedding": [
                                "Succeeded",
                                "Failed",
                                "TimedOut"
                              ]
                            }
                          }
                        }
                      }
                    },
                    "default": {
                      "actions": {
                        "Create_hybrid_query_embedding": {
                          "type": "Http",
                          "inputs": {
                            "method": "POST",
                            "uri": "@{appsetting('AZURE_OPENAI_ENDPOINT')}/openai/deployments/@{appsetting('AZURE_OPENAI_EMBEDDING_MODEL')}/embeddings?api-version=@{appsetting('AZURE_OPENAI_EMBEDDING_API_VERSION')}",
                            "headers": {
                              "Content-Type": "application/json"
                            },
                            "authentication": {
                              "type": "ManagedServiceIdentity",
                              "audience": "https://cognitiveservices.azure.com"
                            },
                            "body": {
                              "input": "@{outputs('Normalize_query')}"
                            }
                          }
                        },
                        "Use_hybrid_embedding_or_fallback": {
                          "type": "If",
                          "expression": "@and(equals(outputs('Create_hybrid_query_embedding')?['statusCode'], 200), not(empty(body('Create_hybrid_query_embedding')?['data']?[0]?['embedding'])))",
                          "actions": {
                            "Call_hybrid_search_with_embedding": {
                              "type": "Http",
                              "inputs": {
                                "method": "POST",
                                "uri": "@{appsetting('CONTAINER_APP_BASE_URL')}/api/search/hybrid/vector",
                                "headers": {
                                  "Content-Type": "application/json"
                                },
                                "body": {
                                  "query": "@{outputs('Normalize_query')}",
                                  "top": "@outputs('Resolve_top')",
                                  "vector_field": "@{outputs('Resolve_vector_field')}",
                                  "query_vector": "@body('Create_hybrid_query_embedding')?['data']?[0]?['embedding']"
                                }
                              }
                            },
                            "Return_hybrid_search": {
                              "type": "Response",
                              "kind": "Http",
                              "inputs": {
                                "statusCode": "@outputs('Call_hybrid_search_with_embedding')?['statusCode']",
                                "headers": {
                                  "Content-Type": "application/json",
                                  "x-docpipeline-search-mode": "hybrid"
                                },
                                "body": "@body('Call_hybrid_search_with_embedding')"
                              },
                              "runAfter": {
                                "Call_hybrid_search_with_embedding": [
                                  "Succeeded",
                                  "Failed",
                                  "TimedOut"
                                ]
                              }
                            }
                          },
                          "else": {
                            "actions": {
                              "Call_hybrid_fallback_full_text": {
                                "type": "Http",
                                "inputs": {
                                  "method": "POST",
                                  "uri": "@{appsetting('CONTAINER_APP_BASE_URL')}/api/search/full-text",
                                  "headers": {
                                    "Content-Type": "application/json"
                                  },
                                  "body": {
                                    "query": "@{outputs('Normalize_query')}",
                                    "top": "@outputs('Resolve_top')"
                                  }
                                }
                              },
                              "Return_hybrid_fallback_full_text": {
                                "type": "Response",
                                "kind": "Http",
                                "inputs": {
                                  "statusCode": "@outputs('Call_hybrid_fallback_full_text')?['statusCode']",
                                  "headers": {
                                    "Content-Type": "application/json",
                                    "x-docpipeline-search-mode": "full-text-fallback",
                                    "x-docpipeline-fallback-reason": "embedding-unavailable"
                                  },
                                  "body": "@body('Call_hybrid_fallback_full_text')"
                                },
                                "runAfter": {
                                  "Call_hybrid_fallback_full_text": [
                                    "Succeeded",
                                    "Failed",
                                    "TimedOut"
                                  ]
                                }
                              }
                            }
                          },
                          "runAfter": {
                            "Create_hybrid_query_embedding": [
                              "Succeeded",
                              "Failed",
                              "TimedOut"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "runAfter": {
          "Resolve_vector_field": [
            "Succeeded"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateless"
}
